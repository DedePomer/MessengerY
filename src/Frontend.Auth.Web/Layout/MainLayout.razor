@inherits LayoutComponentBase
@inject IJSRuntime Js



<div class="page">
    <main>
        <div class="header finisher-header finisher-container">
            <div>
                <div class="center-box">
                    @Body
                </div>
            </div>
        </div>
    </main>
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Js.InvokeVoidAsync("initializeFinisherHeader");
        }
    }
}
