@inherits LayoutComponentBase
@inject IJSRuntime JS



<div class="page">
    <main>
        <div class="header finisher-header finisher-container">
            <div>
                <div class="center-box">
                    <h2>Вход</h2>
                    @Body
                    <a href="#" class="register-link">Нет аккаунта? Регистрация</a>
                </div>
            </div>
        </div>
    </main>
</div>

@code {
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("initializeFinisherHeader");
        }
    }
}
