@page "/login"

<h2>Вход</h2>

<input type="text" @bind="loginInput" placeholder="Логин" />
<input type="password" @bind="passwordInput" placeholder="Пароль" />

<button>Войти</button>

<p class="switch-page-text">
    Нет аккаунта? 
    <a href="/register" class="switch-page-link">Зарегистрироваться</a>
</p>
@code {
    private string loginInput = String.Empty;
    private string passwordInput = String.Empty;

    
}