@page "/login"

<h2>Вход</h2>

<input type="text" @bind="_loginInput" placeholder="Логин" />
<input type="password" @bind="_passwordInput" placeholder="Пароль" />

<button @onclick="SigninCommand">Войти</button>

<p class="switch-page-text">
    Нет аккаунта? 
    <a href="/register" class="switch-page-link">Зарегистрироваться</a>
</p>

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="error-message">@_errorMessage</div>
}

@code {
    private string _loginInput = String.Empty;
    private string _passwordInput = String.Empty;
    private string? _errorMessage;

    
    private async Task SigninCommand()
    {
        if (_loginInput != String.Empty && _passwordInput != String.Empty)
        {
            
        }

        _errorMessage = "Заполните поля для входа";
    }
}