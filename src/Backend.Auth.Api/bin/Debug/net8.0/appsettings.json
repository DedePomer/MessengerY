{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "System": "Error"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext", "WithThreadId" ],
    "Properties": {
      "Application": "AuthAPI"
    }
  },
  "AllowedHosts": "*",
  
  "ConnectionStrings": {
    "UserDBConnection": "Host=localhost; Port=5432; Database=usersDB; Username=postgres; Password=123;"
  }
}
